# Copy this file to ".env" and edit the values
DOMAIN=learn.peakpoints-technicalsolutions.com
# Full public address of the portal (used for links inside emails). Defaults to https://DOMAIN
BASE_URL=https://learn.peakpoints-technicalsolutions.com
SESSION_SECRET=replace-with-a-long-random-string

# ---- Email (required for the "Forgot password?" reset link) ----
# Gmail / Google Workspace defaults. Use a Google App Password for SMTP_PASS,
# not your normal account password; enter the 16-character password without spaces.
# Microsoft 365: SMTP_HOST=smtp.office365.com, port 587, SMTP_SECURE=false.
# Use the SMTP host and credentials supplied by your email provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Must be an address allowed by your SMTP provider; defaults to SMTP_USER when blank.
SMTP_FROM=

# Timezone used for the "Date of Issue" printed on certificates
CERT_TIMEZONE=Asia/Kolkata

# The first admin (devaraju@peakpoints-technicalsolutions.com / Devaraju_401) is created automatically on first start.
# Leave these commented out unless you want a different first admin. They never overwrite an existing account.
# ADMIN_NAME=Devaraju
# ADMIN_EMAIL=devaraju@peakpoints-technicalsolutions.com
# ADMIN_PASSWORD=

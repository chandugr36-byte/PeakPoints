<%- include('../partials/header') %>
<p><a href="/admin/courses">&larr; All courses</a></p>
<h1><%= course.title %></h1>

<div class="card">
  <h2>Course details</h2>
  <form method="post" action="/admin/courses/<%= course.id %>">
    <%- csrfField() %>
    <label>Title <input name="title" value="<%= course.title %>" required maxlength="200"></label>
    <label>Description <textarea name="description" rows="3" maxlength="2000"><%= course.description %></textarea></label>
    <button class="btn">Save</button>
  </form>
  <form method="post" action="/admin/courses/<%= course.id %>/delete" data-confirm="Delete this course with all its lessons, tests and results?">
    <%- csrfField() %>
    <button class="btn danger">Delete course</button>
  </form>
</div>

<div class="card">
  <h2>Lessons</h2>
  <% if (!lessons.length) { %><p class="muted">No lessons yet.</p><% } %>
  <% lessons.forEach((l, i) => { %>
    <div class="row">
      <div><b><%= i + 1 %>. <%= l.title %></b>
        <% if (l.video_url) { %><br><a href="<%= l.video_url %>" target="_blank" rel="noopener noreferrer">Video link</a><% } %>
      </div>
      <form method="post" action="/admin/lessons/<%= l.id %>/delete" data-confirm="Delete this lesson?">
        <%- csrfField() %><button class="btn small danger">Delete</button>
      </form>
    </div>
  <% }) %>
  <h3>Add lesson</h3>
  <form method="post" action="/admin/courses/<%= course.id %>/lessons">
    <%- csrfField() %>
    <label>Lesson title <input name="title" required maxlength="200"></label>
    <label>Content <textarea name="content" rows="6" maxlength="20000"></textarea></label>
    <label>Video / resource link (optional) <input name="video_url" placeholder="https://..." maxlength="500"></label>
    <button class="btn">Add lesson</button>
  </form>
</div>

<div class="card">
  <h2>Tests</h2>
  <% if (!tests.length) { %><p class="muted">No tests yet.</p><% } %>
  <% tests.forEach(t => { %>
    <div class="row">
      <div><b><a href="/admin/tests/<%= t.id %>"><%= t.title %></a></b>
        <span class="muted"> &middot; <%= t.questions %> questions &middot; pass mark <%= t.pass_mark %>%</span></div>
      <a href="/admin/tests/<%= t.id %>/results">Results</a>
    </div>
  <% }) %>
  <h3>Create test</h3>
  <form method="post" action="/admin/courses/<%= course.id %>/tests">
    <%- csrfField() %>
    <label>Test title <input name="title" required maxlength="200"></label>
    <label>Pass mark (%) <input type="number" name="pass_mark" value="50" min="0" max="100"></label>
    <button class="btn">Create test</button>
  </form>
</div>

<div class="card">
  <h2>Import / export</h2>
  <p>
    <a class="btn secondary" href="/admin/courses/<%= course.id %>/export">Export this course</a>
    <a class="btn secondary" href="/admin/courses/<%= course.id %>/tests/export">Export its tests only</a>
  </p>
  <h3>Import tests into this course</h3>
  <form method="post" action="/admin/courses/<%= course.id %>/tests/import?_csrf=<%= csrf %>" enctype="multipart/form-data">
    <label>File: PeakPoints tests (.json) <i>or</i> questions sheet (.csv) <input type="file" name="file" accept=".json,.csv,application/json,text/csv" required></label>
    <p class="muted">Only for a .csv file: a new test is created from its rows. <a href="/admin/tests/template.csv">Download CSV template</a></p>
    <label>Test title (for .csv) <input name="title" maxlength="200"></label>
    <label>Pass mark % (for .csv) <input type="number" name="pass_mark" value="50" min="0" max="100"></label>
    <button class="btn">Import tests</button>
  </form>
</div>

<div class="card">
  <h2>Assign interns</h2>
  <% if (!interns.length) { %>
    <p class="muted">No interns yet. <a href="/admin/interns">Create interns first</a>.</p>
  <% } else { %>
  <form method="post" action="/admin/courses/<%= course.id %>/assign">
    <%- csrfField() %>
    <% interns.forEach(s => { %>
      <label class="check"><input type="checkbox" name="intern_ids" value="<%= s.id %>" <%= s.enrolled ? 'checked' : '' %>>
        <%= s.name %> <span class="muted">(<%= s.email %>)</span></label>
    <% }) %>
    <button class="btn">Save assignments</button>
  </form>
  <% } %>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<h1>My courses</h1>
<% if (certificate) { %>
<div class="card result pass">
  <h2>Internship completion certificate</h2>
  <p>Congratulations! Your certificate (<%= certificate.cert_no %>) is ready.</p>
  <a class="btn" href="/intern/certificate">View / print certificate</a>
</div>
<% } %>
<% if (!courses.length) { %>
  <div class="card"><p>No courses have been assigned to you yet. Please check back later.</p></div>
<% } else { %>
<div class="grid">
  <% courses.forEach(c => { %>
  <a class="card course" href="/intern/courses/<%= c.id %>">
    <h2><%= c.title %></h2>
    <p><%= c.description %></p>
    <p class="muted"><%= c.lessons %> lessons &middot; <%= c.tests %> tests
      <% if (c.tests) { %>&middot; <%= c.passed %>/<%= c.tests %> passed<% } %></p>
  </a>
  <% }) %>
</div>
<% } %>
<%- include('../partials/footer') %>
